{
  "manifest_version": 3,
  "name": "Vagas: documentos do cofre",
  "version": "1.0.0",
  "description": "Preenche CPF, RG e outros documentos do cofre do mcp-vagas nos formulários de candidatura, com a sua confirmação por empresa.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vagas: documentos do cofre"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
